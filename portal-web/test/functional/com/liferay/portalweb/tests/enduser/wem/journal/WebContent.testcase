	@priority = "5"
	test MoveWebContentToFolderTraining {
		property testray.component.names = "Training";

		WebContentNavigator.openWebContentAdmin(siteURLKey = "test-site-name");

		WebContentNavigator.gotoAddCP();

		WebContent.addCP(

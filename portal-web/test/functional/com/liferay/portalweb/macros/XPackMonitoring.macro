definition {

	macro viewAsGuestPG {
		Navigator.openSpecificURL(url = "http://localhost:8080/o/portal-search-elasticsearch-xpack-monitoring/xpack-monitoring-proxy/app/monitoring");

		AssertTextPresent(
			locator1 = "//body",
			value1 = "X-Pack Monitoring is temporarily unavailable.");

		AssertTextPresent(
			locator1 = "//body",
			value1 = "Please sign in to access this application.");
	}

	macro viewPG {
		var serverVersion = SearchAdministration.getServerVersion();

		Navigator.gotoPage(pageName = "X-Pack Monitoring Page");

		SelectFrame.selectFrameNoLoading(locator1 = "IFrame#XPACK_MONITORING");

		if (IsElementPresent(ariaLabel = "Closes this modal window", locator1 = "Button#ANY_WITH_ARIA_LABEL")) {
			SetWindowSize(value1 = "500,500");

			Click(
				ariaLabel = "Closes this modal window",
				locator1 = "Button#ANY_WITH_ARIA_LABEL");

			SetWindowSize(value1 = "800,800");
		}

		AssertTextPresent(
			locator1 = "XPackMonitoring#CLUSTER_NAME",
			value1 = "LiferayElasticsearchCluster");

		if (contains("${serverVersion}", "7.17.0")) {
			AssertElementPresent(
				key_title = "Cluster overview",
				locator1 = "Header#H1_TITLE");
		}
		else {
			AssertElementPresent(locator1 = "XPackMonitoring#MONITORING_CLUSTER_OVERVIEW");
		}

		AssertElementPresent(
			key_title = "Elasticsearch",
			locator1 = "Header#H2_TITLE");

		AssertElementPresent(
			key_title = "Kibana",
			locator1 = "Header#H2_TITLE");
	}

}
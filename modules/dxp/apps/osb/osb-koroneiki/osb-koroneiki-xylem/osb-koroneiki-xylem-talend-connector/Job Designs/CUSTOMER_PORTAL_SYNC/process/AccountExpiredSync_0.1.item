  <node componentName="tJava" componentVersion="0.101" offsetLabelX="0" offsetLabelY="0" posX="128" posY="64">
    <elementParameter field="TEXT" name="UNIQUE_NAME" value="tJava_1" show="false"/>
    <elementParameter field="MEMO_JAVA" name="CODE" value="System.out.println(&quot;Start expired accounts sync job&quot;);&#xA;System.out.println(&quot;Syncing to &quot; + context.customerPortalHost + &quot; using &quot; + context.customerPortalUserName);&#xA;&#xA;if (context.deltaMins == null) {&#xA;&#x9;context.deltaMins = 1440;&#xA;}&#xA;&#x9;&#x9;&#xA;if (context.lastRunStartDate != null) {&#xA;&#x9;String sanitizedLastRunStartDate = context.lastRunStartDate.trim();&#xA;&#xA;&#x9;if (!sanitizedLastRunStartDate.isEmpty()) {&#xA;&#x9;&#x9;Date date = TalendDate.parseDate(&quot;yyyy-MM-dd'T'HH:mm:ssZ&quot;, sanitizedLastRunStartDate);&#xA;&#x9;&#x9;&#xA;&#x9;&#x9;date = new Date(date.getTime() - (context.deltaMins * 60 * 1000));&#xA;&#x9;&#x9;&#xA;&#x9;&#x9;context.lastRunStartDate = TalendDate.formatDate(&#xA;&#x9;&#x9;&#x9;&quot;yyyy-MM-dd'T'HH:mm:ss'Z'&quot;, date);&#xA;&#x9;}&#xA;&#x9;else {&#xA;&#x9;&#x9;context.lastRunStartDate = null;&#xA;&#x9;}&#xA;}&#xA;&#xA;if (context.lastRunStartDate == null) {&#xA;&#x9;context.lastRunStartDate = TalendDate.formatDate(&quot;yyyy-MM-dd'T'HH:mm:ss'Z'&quot;, new Date(System.currentTimeMillis() - (context.deltaMins * 60 * 1000)));&#xA;}&#xA;&#xA;if ((context.accountSyncFilter == null) || context.accountSyncFilter.equals(&quot;&quot;)) {&#xA;&#x9;context.accountSyncFilter = &quot;entitlements/any(s:not contains(s, 'Subscription') and not (s eq 'Partner')) and dateModified gt &quot; + context.lastRunStartDate;&#xA;}&#xA;&#xA;globalMap.put(&quot;dataRetentionDate&quot;, TalendDate.formatDate(&quot;yyyy-MM-dd&quot;, new Date(System.currentTimeMillis() - (context.dataRetentionDays * 86400000L))));&#xA;&#xA;// Test&#xA;//context.accountSyncFilter = &quot;entitlements/any(s:contains(s, 'Subscription') or s eq 'Partner') and (code eq 'FIFAWCQATAR')&quot;;&#xA;//globalMap.put(&quot;dataRetentionDate&quot;, &quot;2023-04-01&quot;);&#xA;// Test end&#xA;&#xA;System.out.println(&quot;Syncing expired accounts with filter: &quot; + context.accountSyncFilter);&#xA;System.out.println(&quot;DataRetentionDate: &quot; + globalMap.get(&quot;dataRetentionDate&quot;));"/>
    <elementParameter field="MEMO_IMPORT" name="IMPORT" value="//import java.util.List;"/>
    <elementParameter field="TEXT" name="CONNECTION_FORMAT" value="row"/>
    <metadata connector="FLOW" name="tJava_1"/>
  </node>

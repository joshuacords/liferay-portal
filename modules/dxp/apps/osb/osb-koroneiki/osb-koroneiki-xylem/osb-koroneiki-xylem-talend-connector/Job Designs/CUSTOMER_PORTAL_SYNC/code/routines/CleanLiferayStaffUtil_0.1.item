package routines;

import routines.system.JSONArray;
import routines.system.JSONObject;

/**
 * @author Amos Fong
 */
public class CleanLiferayStaffUtil {

	public static String getRemoveUserEmailAddress(
		String customerContacts, String emailAddress) {

		JSONArray jsonArray = new JSONArray(customerContacts);

		for (int i = 0; i < jsonArray.length(); i++) {
			JSONObject jsonObject = jsonArray.getJSONObject(i);

			String curEmailAddress = jsonObject.getString("emailAddress");

			if (emailAddress.equalsIgnoreCase(curEmailAddress)) {
				return "";
			}
		}

		return emailAddress;
	}

}
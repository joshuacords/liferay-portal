package routines;

import java.util.Map;

import routines.system.JSONArray;
import routines.system.JSONObject;

/**
 * @author Amos Fong
 */
public class CleanUserAccountRolesUtil {

	public static Long getRemoveAccountRoleId(
		Map<String, Object> globalMap, String contactRoles,
		Long accountRoleId) {

		JSONArray jsonArray = new JSONArray(contactRoles);

		for (int i = 0; i < jsonArray.length(); i++) {
			JSONObject jsonObject = jsonArray.getJSONObject(i);

			String curAccountRoleId = ContactRoleParser.getAccountRoleId(
				globalMap, jsonObject.getString("name"));

			if (curAccountRoleId.isEmpty()) {
				continue;
			}

			try {
				if (accountRoleId == Long.valueOf(curAccountRoleId)) {
					return 0L;
				}
			}
			catch (Exception e) {
			}
		}

		return accountRoleId;
	}

}
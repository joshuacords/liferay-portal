package routines;

import java.text.DateFormat;
import java.text.SimpleDateFormat;

import java.util.Date;

import routines.system.JSONObject;

/**
 * @author Amos Fong
 */
public class DateUtil {

	public static String format(Date date) {
		if (date == null) {
			return "";
		}

		return _simpleDateFormat.format(date);
	}

	public static String getLastRunStartDate(
		String lastRunStartDate, Integer deltaMins) {

		if (deltaMins == null) {
			deltaMins = 5;
		}

		String formattedLastRunStartDate = null;

		if (lastRunStartDate != null) {
			String sanitizedLastRunStartDate = lastRunStartDate.trim();

			if (!sanitizedLastRunStartDate.isEmpty()) {
				Date date = TalendDate.parseDate(
					"yyyy-MM-dd'T'HH:mm:ssZ", sanitizedLastRunStartDate);

				date = new Date(date.getTime() - (deltaMins * 60 * 1000));

				formattedLastRunStartDate = TalendDate.formatDate(
					"yyyy-MM-dd'T'HH:mm:ss'Z'", date);
			}
		}

		if (formattedLastRunStartDate == null) {
			//formattedLastRunStartDate = TalendDate.formatDate("yyyy-MM-dd'T'HH:mm:ss'Z'", new Date(0));

			// 2021-01-01T00:00:00Z

			//formattedLastRunStartDate = TalendDate.formatDate("yyyy-MM-dd'T'HH:mm:ss'Z'", new Date(1609488000000L));

			formattedLastRunStartDate = TalendDate.formatDate(
				"yyyy-MM-dd'T'HH:mm:ss'Z'",
				new Date(System.currentTimeMillis() - (deltaMins * 60 * 1000)));
		}

		return formattedLastRunStartDate;
	}

	public static Date parseDate(JSONObject jsonObject, String fieldName)
		throws Exception {

		String dateString = jsonObject.optString(fieldName);

		if (dateString.isEmpty()) {
			return null;
		}

		DateFormat dateFormat = new SimpleDateFormat(Constants.DATE_PATTERN);

		return dateFormat.parse(dateString);
	}

	public static Date parseEndDate(JSONObject jsonObject) throws Exception {
		String dateString = jsonObject.optString("endDate");

		if (dateString.isEmpty()) {
			return new Date(Constants.END_DATE_PERPETUAL);
		}

		DateFormat dateFormat = new SimpleDateFormat(Constants.DATE_PATTERN);

		return dateFormat.parse(dateString);
	}

	public static Date parseOriginalEndDate(JSONObject jsonObject)
		throws Exception {

		String dateString = jsonObject.optString("originalEndDate");

		if (dateString.isEmpty()) {
			return new Date(Constants.END_DATE_PERPETUAL);
		}

		DateFormat dateFormat = new SimpleDateFormat(Constants.DATE_PATTERN);

		return dateFormat.parse(dateString);
	}

	public static Date parseStartDate(JSONObject jsonObject) throws Exception {
		String dateString = jsonObject.optString("startDate");

		if (dateString.isEmpty()) {
			return new Date(Constants.START_DATE_PERPETUAL);
		}

		DateFormat dateFormat = new SimpleDateFormat(Constants.DATE_PATTERN);

		return dateFormat.parse(dateString);
	}

	private static final SimpleDateFormat _simpleDateFormat =
		new SimpleDateFormat(Constants.DATE_PATTERN);

}
package routines;

import routines.system.JSONArray;
import routines.system.JSONObject;

/**
 * @author Amos Fong
 */
public class TransformProduct {

	public static String getName(String name, String properties) {
		if (!properties.isEmpty()) {
			JSONObject propertiesJSONObject = new JSONObject(properties);

			String displayName = propertiesJSONObject.optString("display-name");

			if ((displayName != null) && !displayName.isEmpty()) {
				name = displayName;
			}
		}

		JSONObject jsonObject = new JSONObject();

		jsonObject.put("en_US", name);

		return jsonObject.toString();
	}

	public static String getProductType() {
		return "simple";
	}

	public static String getSkus(String productKey) {
		JSONArray jsonArray = new JSONArray();

		JSONObject jsonObject = new JSONObject();

		jsonObject.put("externalReferenceCode", productKey);
		jsonObject.put("published", true);
		jsonObject.put("purchasable", true);
		jsonObject.put("sku", productKey);

		jsonArray.put(jsonObject);

		return jsonArray.toString();
	}

}
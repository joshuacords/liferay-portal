{namespace FieldBase}

{template .render}
	{@param name: string}
	{@param? _handleAddRepeatedFieldButtonClicked: any}
	{@param? _handleFieldClicked: any}
	{@param? _handleRemoveRepeatedFieldButtonClicked: any}
	{@param? addDuplicateField: string}
	{@param? contentRenderer: any}
	{@param? displayErrors: bool}
	{@param? errorMessage: string}
	{@param? id: string}
	{@param? tip: string}
	{@param? label: string}
	{@param? requiredText: string}
	{@param? readOnly: bool}
	{@param? removeDuplicateField: string}
	{@param? required: bool}
	{@param? repeatable: bool}
	{@param? showLabel: bool}
	{@param? showRepeatableRemoveButton: bool}
	{@param? spritemap: string}
	{@param? text: html}
	{@param? tooltip: string}
	{@param? type: string}
	{@param? valid: bool}
	{@param? visible: bool}

	{let $fieldCssClassAttribute kind="text"}
		form-group

		{if $displayErrors and $errorMessage and $valid == false}
			{sp}has-error
		{/if}

		{if $visible == false}
			{sp}hide
		{/if}
	{/let}

	{let $fieldNameOrId: $id ? $id : $name /}

	{let $fieldDetailsId: $fieldNameOrId + '_fieldDetails' /}

	{let $renderlabel: ($label and $showLabel) or $required or $tooltip or $repeatable /}

	{let $divAttributes kind="attributes"}
		{if not $renderlabel}
			tabindex="0"

			aria-labelledby="{$fieldDetailsId}"
		{/if}

		class="{$fieldCssClassAttribute}"

		data-field-name="{$name}"

		data-onclick="{$_handleFieldClicked}"
	{/let}

	<div {$divAttributes}>
		{if $repeatable}
			<div class="lfr-ddm-form-field-repeatable-toolbar">
				{if $showRepeatableRemoveButton}
					{let $delete kind="text"}
						{msg desc=""} {$removeDuplicateField} {/msg}
					{/let}

					{call ClayButton.render}
						{param ariaLabel: $delete /}
						{param disabled: $readOnly /}
						{param elementClasses: 'btn-xs ddm-form-field-repeatable-delete-button p-0' /}
						{param events: ['click': $_handleRemoveRepeatedFieldButtonClicked] /}
						{param icon: 'trash' /}
						{param spritemap: $spritemap /}
						{param type: 'button' /}
					{/call}
				{/if}

				{let $duplicate kind="text"}
					{msg desc=""} {$addDuplicateField} {/msg}
				{/let}

				{call ClayButton.render}
					{param ariaLabel: $duplicate /}
					{param disabled: $readOnly /}
					{param elementClasses: 'btn-xs ddm-form-field-repeatable-add-button p-0' /}
					{param events: ['click': $_handleAddRepeatedFieldButtonClicked] /}
					{param icon: 'plus' /}
					{param spritemap: $spritemap /}
					{param type: 'button' /}
				{/call}
			</div>
		{/if}

		{let $showFor: $type and ($type == 'text' or $type == 'numeric' or $type == 'select') /}
		{let $readFieldDetails: not $showFor or $type == 'select' /}

		{let $labelAttributes kind="attributes"}
			{if $readFieldDetails}
				tabindex="0"

				aria-labelledby="{$fieldDetailsId}"
			{elseif $showFor}
				for="{$fieldNameOrId}"
			{/if}

			{if not $showLabel and not $required}
				class="ddm-empty"
			{else}
				class="ddm-label"
			{/if}
		{/let}

		{if $renderlabel}
			{let $fieldProperties kind="html"}
				{if $required and $spritemap}
					<span class="reference-mark">
						{call ClayIcon.render}
							{param spritemap: $spritemap /}
							{param symbol: 'asterisk' /}
						{/call}
					</span>
				{/if}

				{if $tooltip}
					{call Tooltip.render}
						{param ariaLabel: $tooltip /}
						{param icon: 'question-circle-full' /}
						{param spritemap: $spritemap /}
						{param text: $tooltip /}
					{/call}
				{/if}
			{/let}

			{let $showLegend: $type and ($type == 'checkbox_multiple' or $type == 'grid' or $type == 'paragraph' or $type == 'radio') /}

			{if $showLegend}
				<fieldset>
					<legend aria-labelledby="{$fieldDetailsId}" class="lfr-ddm-legend" tabIndex="0">
						{if $label and $showLabel}
							{$label}{sp}
						{/if}

						{$fieldProperties}
					</legend>

					{$contentRenderer}
				</fieldset>
			{else}
				<label {$labelAttributes}>
					{if $label and $showLabel}
						{$label}{sp}
					{/if}

					{$fieldProperties}
				</label>

				{$contentRenderer}
			{/if}
		{else}
			{$contentRenderer}
		{/if}

		{let $hasError: $displayErrors and ($errorMessage != null and $errorMessage != '') and not $valid /}
		{let $hasFieldDetails: $readFieldDetails and ($label or $tip or $text or $hasError) /}

		{if $hasFieldDetails}
			<span id="{$fieldDetailsId}" class="sr-only">
				{if $label}{sp}{$label}{/if}

				{if $tip}{sp}{$tip}{/if}

				{if $text}{sp}{$text}{/if}

				{if $hasError}{sp}{$errorMessage}{elseif $required}{sp}{$requiredText}{/if}
			</span>
		{/if}

		{let $ariaHidden: $hasFieldDetails ? 'true' : 'false' /}

		{if $tip}
			<span id="{$fieldNameOrId + '_fieldHelp'}" class="form-text" aria-hidden="{$ariaHidden}">{$tip}</span>
		{/if}

		{if $displayErrors and $errorMessage and $valid == false}
			<div class="form-feedback-group">
				<div id="{$fieldNameOrId + '_fieldError'}" role="alert" class="form-feedback-item help-block" aria-hidden="{$ariaHidden}">{$errorMessage}</div>
			</div>
		{/if}
	</div>
{/template}
Bundle-Name: Liferay Commerce Subscription Web
Bundle-SymbolicName: com.liferay.commerce.subscription.web
Bundle-Version: 2.0.8
Import-Package:\
	com.liferay.frontend.taglib.clay.servlet.taglib.util;version="[1.0.0,9999.0.0)",\
	\
	*
Provide-Capability:\
	liferay.resource.bundle;\
		resource.bundle.aggregate:String="(bundle.symbolic.name=com.liferay.commerce.lang)";\
		resource.bundle.base.name="content.Language"
Web-ContextPath: /commerce-subscription-web